# ================================================================
# Logistox - متغيرات البيئة
# نظام إدارة المخازن والمخزون v5.0
# مخصص لشركة البركة لتوريد وتصنيع اللحوم - مصر
# ================================================================

# ================================================================
# 1. إعدادات التطبيق
# ================================================================

APP_NAME=Logistox
APP_VERSION=5.0.0
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/inventory-system
APP_TIMEZONE=Africa/Cairo

# ================================================================
# 2. إعدادات قاعدة البيانات
# ================================================================

DB_HOST=localhost
DB_PORT=3306
DB_NAME=inventory_system
DB_USER=angel
DB_PASS=Lecico10@
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ================================================================
# 3. إعدادات JWT (المصادقة)
# ================================================================

JWT_SECRET=logistox_jwt_secret_2026_secure_0123456789
JWT_EXPIRY=86400
JWT_REFRESH_EXPIRY=604800
JWT_ALGORITHM=HS256

# ================================================================
# 4. إعدادات الجلسات
# ================================================================

SESSION_NAME=LOGISTOX_SESSION
SESSION_LIFETIME=3600
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# ================================================================
# 5. إعدادات الأمان
# ================================================================

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900
PASSWORD_MIN_LENGTH=8
TWO_FACTOR_ENABLED=false
CSRF_ENABLED=true

# ================================================================
# 6. إعدادات البريد (مصري)
# ================================================================

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@logistox.com
MAIL_FROM_NAME=Logistox

# ================================================================
# 7. إعدادات النظام (مصرية)
# ================================================================

DEFAULT_LANGUAGE=ar
DEFAULT_THEME=dark
DEFAULT_CURRENCY=EGP
DEFAULT_CURRENCY_SYMBOL=ج.م
DECIMAL_PLACES=2
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm:ss
DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss

# ================================================================
# 8. إعدادات التنبيهات
# ================================================================

LOW_STOCK_THRESHOLD=10
OUT_OF_STOCK_THRESHOLD=0
EXPIRY_WARNING_DAYS=30
EXPIRY_CRITICAL_DAYS=7
AUTO_REFRESH_INTERVAL=30000

# ================================================================
# 9. إعدادات التقارير (شركة البركة - مصر)
# ================================================================

REPORT_COMPANY_NAME=شركة البركة لتوريد وتصنيع اللحوم
REPORT_ADDRESS=جمهورية مصر العربية
REPORT_PHONE=01286187173
REPORT_EMAIL=info@albaraka.com
REPORT_LOGO=/assets/images/logo.png
REPORT_FOOTER=Logistox v5.0 - نظام إدارة المخازن والمخزون

# ================================================================
# 10. إعدادات API
# ================================================================

API_RATE_LIMIT=60
API_RATE_WINDOW=60
API_VERSION=v1
API_PREFIX=/api

# ================================================================
# 11. إعدادات المطور (مصري)
# ================================================================

DEVELOPER_NAME=Abdelrahman.KH
DEVELOPER_ALIAS=BurnMyWallet
DEVELOPER_PHONE_1=01286187173
DEVELOPER_PHONE_2=01027191811
DEVELOPER_WHATSAPP=201286187173
DEVELOPER_EMAIL=abdelrahman@logistox.com

# ================================================================
# 12. إعدادات المسارات
# ================================================================

BASE_PATH=/inventory-system
FRONTEND_PATH=/var/www/html/inventory-system/frontend
BACKEND_PATH=/var/www/html/inventory-system/backend
LOG_PATH=/var/www/html/inventory-system/logs
TMP_PATH=/var/www/html/inventory-system/tmp
BACKUP_PATH=/var/www/html/inventory-system/backups

# ================================================================
# 13. إعدادات التخزين المؤقت
# ================================================================

CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_PREFIX=logistox_

# ================================================================
# 14. إعدادات التصدير
# ================================================================

EXPORT_FORMATS=pdf,excel,csv,print
EXPORT_MAX_ROWS=10000
EXPORT_FILE_PREFIX=logistox_export

# ================================================================
# 15. إعدادات النسخ الاحتياطي
# ================================================================

BACKUP_ENABLED=true
BACKUP_INTERVAL=daily
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# ================================================================
# 16. إعدادات الأخطاء والسجلات
# ================================================================

LOG_ERRORS=true
LOG_ACCESS=true
LOG_SLOW_QUERIES=true
SLOW_QUERY_THRESHOLD=1000
ERROR_REPORTING=E_ALL
DISPLAY_ERRORS=false
LOG_ERRORS_DETAILED=true

# ================================================================
# نهاية ملف .env
# ================================================================
