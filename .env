# قاعدة البيانات
DB_HOST=localhost
DB_NAME=inventory_system
DB_USER=angel
DB_PASS=Lecico10@
DB_CHARSET=utf8mb4

# النظام
APP_NAME="نظام المخازن المتقدم"
APP_ENV=production
APP_DEBUG=true
APP_URL=http://localhost:8080
TIMEZONE=Asia/Riyadh
VERSION=3.0.0

# الأمان
JWT_SECRET=761bad3f6af23d1a3bf69ad1f3f9e4dd6229a82a75bfc17bd0b72c7c21ad23d3
SINGLE_SESSION_ENABLED=true
SESSION_TIMEOUT=86400
COOKIE_SECURE=false
COOKIE_HTTP_ONLY=true
COOKIE_SAME_SITE=Strict

# النسخ الاحتياطي
BACKUP_ENABLED=true
BACKUP_TIME="23:00"
BACKUP_RETENTION_DAYS=30
BACKUP_PATH="/var/backups/inventory/"

# التقارير
COMPANY_NAME="شركتي"
COMPANY_TAX_NUMBER="1234567890"
CURRENCY_SYMBOL="ر.س"
REPORT_LOGO="/assets/images/logo.png"

# البريد الإلكتروني
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM=noreply@inventory-system.com
MAIL_FROM_NAME="نظام المخازن"

# واجهة المستخدم
UI_THEME=dark
UI_LANGUAGE=ar
UI_DATE_FORMAT=Y-m-d
UI_TIME_FORMAT=H:i:s
