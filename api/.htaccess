# ================================================================
# Logistox - إعدادات Apache للمسار /api
# ================================================================

# تفعيل إعادة الكتابة
RewriteEngine On

# تعيين الترميز الافتراضي
AddDefaultCharset UTF-8

# منع عرض محتويات المجلدات
Options -Indexes

# ================================================================
# إعادة التوجيه
# ================================================================

# إعادة توجيه جميع الطلبات إلى index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [QSA,L]

# ================================================================
# رؤوس الأمان
# ================================================================

# منع تضمين الصفحة في إطار
Header set X-Frame-Options "SAMEORIGIN"

# منع تخمين نوع المحتوى
Header set X-Content-Type-Options "nosniff"

# سياسة أمان المحتوى
Header set X-XSS-Protection "1; mode=block"

# HSTS (فقط على HTTPS)
# Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# ================================================================
# إعدادات PHP
# ================================================================

# زيادة حجم الذاكرة
php_value memory_limit 256M

# زيادة حجم الملفات المرفوعة
php_value upload_max_filesize 50M
php_value post_max_size 50M

# مهلة التنفيذ
php_value max_execution_time 300
php_value max_input_time 300

# عرض الأخطاء أثناء التطوير
# php_flag display_errors On
# php_flag display_startup_errors On

# إخفاء الأخطاء في الإنتاج
php_flag display_errors Off
php_flag display_startup_errors Off
php_value error_reporting E_ALL

# ================================================================
# التخزين المؤقت
# ================================================================

# تعطيل التخزين المؤقت لملفات PHP
<FilesMatch "\.php$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</FilesMatch>

# ================================================================
# منع الوصول لملفات معينة
# ================================================================

# منع الوصول لملف الإعدادات
<FilesMatch "^(config\.php|database\.php)$">
    Require all denied
</FilesMatch>

# منع الوصول لملفات .env
<FilesMatch "^\.env">
    Require all denied
</FilesMatch>

# منع الوصول لملفات .git
<FilesMatch "^\.git">
    Require all denied
</FilesMatch>

# ================================================================
# انتهى
# ================================================================
