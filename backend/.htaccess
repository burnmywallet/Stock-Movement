# ================================================================
# نظام إدارة المخازن والمخزون المتقدم v5.0
# الملف: backend/.htaccess
# الوصف: منع الوصول المباشر إلى مجلدات Backend - أمان متقدم
# التاريخ: 2026-08-22
# ================================================================

# ================================================================
# 1. إعدادات الأمان الأساسية
# ================================================================

# منع عرض محتويات المجلدات
Options -Indexes

# حماية ملف .htaccess نفسه
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# ================================================================
# 2. منع الوصول إلى الملفات الحساسة
# ================================================================

# منع الوصول إلى ملفات التكوين
<FilesMatch "\.(env|ini|log|sql|json|lock|yml|yaml|xml|conf|config|example)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# منع الوصول إلى ملفات PHP (باستثناء public/index.php)
<FilesMatch "\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# السماح فقط بـ index.php في مجلد public
<Files "public/index.php">
    Order allow,deny
    Allow from all
</FilesMatch>

# ================================================================
# 3. منع الوصول إلى المجلدات الحساسة
# ================================================================

# منع الوصول إلى مجلد core
<IfModule mod_rewrite.c>
    RewriteRule ^core/ - [F,L]
</IfModule>

# منع الوصول إلى مجلد controllers
<IfModule mod_rewrite.c>
    RewriteRule ^controllers/ - [F,L]
</IfModule>

# منع الوصول إلى مجلد models
<IfModule mod_rewrite.c>
    RewriteRule ^models/ - [F,L]
</IfModule>

# منع الوصول إلى مجلد middleware
<IfModule mod_rewrite.c>
    RewriteRule ^middleware/ - [F,L]
</IfModule>

# منع الوصول إلى مجلد services
<IfModule mod_rewrite.c>
    RewriteRule ^services/ - [F,L]
</IfModule>

# منع الوصول إلى مجلد helpers
<IfModule mod_rewrite.c>
    RewriteRule ^helpers/ - [F,L]
</IfModule>

# منع الوصول إلى مجلد routes
<IfModule mod_rewrite.c>
    RewriteRule ^routes/ - [F,L]
</IfModule>

# منع الوصول إلى مجلد logs
<IfModule mod_rewrite.c>
    RewriteRule ^logs/ - [F,L]
</IfModule>

# منع الوصول إلى مجلد storage
<IfModule mod_rewrite.c>
    RewriteRule ^storage/ - [F,L]
</IfModule>

# منع الوصول إلى مجلد backups
<IfModule mod_rewrite.c>
    RewriteRule ^backups/ - [F,L]
</IfModule>

# ================================================================
# 4. إعادة توجيه جميع الطلبات إلى public/index.php
# ================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # إزالة www من URL
    RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
    
    # إعادة توجيه HTTP إلى HTTPS (في الإنتاج)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
    
    # إذا كان الملف موجوداً، لا تعيد التوجيه
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]
    
    # إذا كان المجلد موجوداً، لا تعيد التوجيه
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
    
    # إعادة توجيه جميع الطلبات إلى public/index.php
    RewriteRule ^(.*)$ public/index.php [QSA,L]
</IfModule>

# ================================================================
# 5. رؤوس الأمان الإضافية
# ================================================================

<IfModule mod_headers.c>
    # منع التصفح (Clickjacking)
    Header set X-Frame-Options "SAMEORIGIN"
    
    # حماية XSS
    Header set X-XSS-Protection "1; mode=block"
    
    # منع تخمين نوع المحتوى
    Header set X-Content-Type-Options "nosniff"
    
    # سياسة الإحالة
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # سياسة الأمان للمحتوى (CSP) - أساسية
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:;"
    
    # HSTS (لـ HTTPS فقط - فعّل في الإنتاج)
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # منع عرض أنواع الملفات
    Header set X-Permitted-Cross-Domain-Policies "none"
</IfModule>

# ================================================================
# 6. منع الوصول إلى الملفات المخفية
# ================================================================

<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# ================================================================
# 7. منع الوصول إلى ملفات النسخ الاحتياطي
# ================================================================

<FilesMatch "\.(bak|backup|old|orig|tmp)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ================================================================
# 8. إعدادات الأداء
# ================================================================

# ضغط الملفات
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/xml text/xml
</IfModule>

# التخزين المؤقت
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ================================================================
# 9. إعدادات PHP (إذا كان mod_php مفعلاً)
# ================================================================

<IfModule mod_php7.c>
    php_value upload_max_filesize 50M
    php_value post_max_size 50M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_value date.timezone "Africa/Cairo"
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 50M
    php_value post_max_size 50M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_value memory_limit 256M
    php_value date.timezone "Africa/Cairo"
</IfModule>

# ================================================================
# نهاية ملف .htaccess
# ================================================================
