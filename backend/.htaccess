# ================================================================
# نظام إدارة المخازن والمخزون المتقدم
# الملف: backend/.htaccess
# الوصف: منع الوصول المباشر إلى مجلدات Backend
# الإصدار: 2.0 Production Ready
# التاريخ: 2026-08-20
# ================================================================

# منع عرض محتويات المجلدات
Options -Indexes

# منع الوصول إلى جميع الملفات في مجلد backend
<FilesMatch ".*">
    Order allow,deny
    Deny from all
</FilesMatch>

# السماح بالوصول إلى مجلد public فقط
<FilesMatch "^(public/|index\.php)">
    Order allow,deny
    Allow from all
</FilesMatch>

# منع الوصول إلى ملفات التكوين
<FilesMatch "\.(ini|log|sql|env|json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# منع الوصول إلى ملفات PHP (باستثناء index.php في public)
<FilesMatch "\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# السماح بـ index.php في public
<Files "public/index.php">
    Order allow,deny
    Allow from all
</FilesMatch>

# ================================================================
# نهاية ملف .htaccess
# ================================================================
