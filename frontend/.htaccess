<IfModule mod_rewrite.c>
    RewriteEngine On

    # لو الطلب على ملف موجود، اخدمه
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # لو الطلب على مجلد موجود، اخدمه
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # ===== API Routes =====
    # لو الطلب على /api/... حوله للـBackend
    RewriteRule ^api/(.*)$ ../backend/public/index.php?route=$1 [QSA,L]

    # ===== Frontend =====
    # أي طلب تاني يروح للـindex.html
    RewriteRule ^ index.html [L]
</IfModule>
